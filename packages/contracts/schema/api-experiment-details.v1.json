{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "object",
      "properties": {
        "experimentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "experimentNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
        },
        "definitionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "assessmentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "active": {
          "type": "boolean"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "automatic",
              "guided",
              "manual"
            ]
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "en",
              "si"
            ]
          }
        }
      },
      "required": [
        "experimentId",
        "experimentNumber",
        "titleKey",
        "definitionVersion",
        "assessmentVersion",
        "active",
        "modes",
        "locales"
      ],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "summary",
    "definition"
  ],
  "additionalProperties": false
}
