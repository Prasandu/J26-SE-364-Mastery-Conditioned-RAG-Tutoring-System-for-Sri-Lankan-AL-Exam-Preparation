# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME="Assessment Service"
APP_ENV=development

# Database. Supabase -> Connect -> Direct -> Session pooler -> URI.
# Empty = a local SQLite file (assessment.db).
DATABASE_URL=

# Real user accounts (register/login), at least 32 characters.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = /auth is switched off, and with it every /admin and /review route - they
# need a real signed-in account of the right role, there is no shared-key fallback.
# Changing this logs every signed-in user out, since it invalidates every token
# already issued. The first admin account is made once with app/create_admin.py.
JWT_SECRET=

# /integration routes: the other 3 components of this group project (J26-SE-364)
# read a student's marks/topic performance from this one through these, each with
# its own key, at least 16 characters. Make one with:
# python -c "import secrets; print(secrets.token_urlsafe(16))"
# Empty = that component's calls are rejected (503 if all 3 are empty, 401 for a
# wrong one). See docs/integration-contract.md.
INTEGRATION_KEY_COMPONENT1=
INTEGRATION_KEY_COMPONENT3=
INTEGRATION_KEY_COMPONENT4=

# AI judge. gemini | groq | openrouter | cerebras | github | ollama | custom
AI_PROVIDER=gemini
# Key for every provider except gemini. Ollama needs none.
AI_API_KEY=
# Empty = the provider's default. List them with: python -m app.check_ai --models
AI_MODEL=
# Only for AI_PROVIDER=custom.
AI_BASE_URL=
# Below this confidence (0-1), a decision goes to a teacher instead of counting.
AI_MIN_CONFIDENCE=0.7
# Same, but for judging a drawn structure/diagram/graph from its photo - stricter,
# since misjudging a drawing is costlier than misjudging typed text.
AI_MIN_CONFIDENCE_DRAWING=0.9
# Also ask the AI about points the checker decided. Disagreement -> teacher.
AI_CROSS_CHECK=true

# Google Gemini. Key from https://aistudio.google.com -> Get API key.
# Free tier: use anonymised answers only, never real student details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Reading handwriting. Needs a model that can see images.
VISION_PROVIDER=gemini
# Empty = use GEMINI_MODEL above.
VISION_MODEL=

# Backup reader, used only if the primary one above fails (busy, rate limited,
# quota used up). Empty = no fallback, an upload just fails when the primary does.
# Example: Groq's free quota as a backup for Gemini's, reusing AI_API_KEY above.
# VISION_FALLBACK_PROVIDER=groq
# VISION_FALLBACK_MODEL=qwen/qwen3.8-27b
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_MODEL=

# A second, independent backup - tried only if both the primary and the first
# fallback fail. Needs its own key (not AI_API_KEY above): a free provider's
# per-minute or per-day limit can itself be too small for a dense page's
# structured output, so reusing the same key/quota as the first fallback would
# not add real resilience. Example: OpenRouter's free Gemma vision model
# (openrouter.ai -> Settings -> Keys) as a backup for Groq's per-minute output
# cap. GitHub Models no longer exists (retired July 2026) - do not use it here.
# VISION_FALLBACK_2_PROVIDER=openrouter
# VISION_FALLBACK_2_MODEL=google/gemma-4-31b-it:free
# VISION_FALLBACK_2_API_KEY=
VISION_FALLBACK_2_PROVIDER=
VISION_FALLBACK_2_MODEL=
VISION_FALLBACK_2_API_KEY=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Which web origins may call this API (the frontend). Comma separated.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Resource retrieval (RAG): grounding generated questions in trusted Chemistry
# resources. Local, via sentence-transformers - no API key needed, downloaded once
# from Hugging Face on first use (~2GB). Needs `pip install sentence-transformers`
# plus a CPU build of torch first - see requirements.txt.
EMBEDDING_MODEL=BAAI/bge-m3
# BAAI/bge-m3's own fixed output size - not configurable, unlike the Gemini embedding
# this replaced. Changing this needs a migration (see migrations/versions/0018_*).
EMBEDDING_DIMENSIONS=1024
# Below this cosine similarity a passage is left out, not padded in anyway.
RESOURCE_MIN_SIMILARITY=0.5
RESOURCE_PASSAGES_PER_TOPIC=2
# Where original resource PDFs are kept. Never served by any route.
RESOURCES_DIR=resources
MAX_RESOURCE_UPLOAD_MB=40
# Where original past-paper PDFs are kept. Unlike resources, these ARE served to
# students directly (GET /papers/{id}/file).
PAPERS_DIR=papers
MAX_PAPER_UPLOAD_MB=40

# Verifying generated questions. The deterministic validators always run, free.
# true also asks a second model to critique each question, at one extra call each.
# A critique can only refer a question to a teacher, never reject or approve it.
VERIFY_WITH_AI=false

# How many times a section may be asked for again when questions are rejected.
GENERATE_MAX_ATTEMPTS=2

# Practice papers a student may make per day (the AI quota is shared)
PRACTICE_PAPERS_PER_DAY=3
PRACTICE_QUESTIONS_AT_ONCE=15

# Whole-service ceiling on practice papers per day (protects the AI quota)
PRACTICE_PAPERS_PER_DAY_TOTAL=40
