  "parameters": [
    {
      "parameterId": "param.mass_tolerance",
      "value": 0.05,
      "unit": "g",
      "rationale": "NIE pages give no mass tolerance (gap F3). About 0.2% of 26.5 g; within reach of a four beam balance read to 0.01 g.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "measurement_tolerance",
      "version": 1
    },
    {
      "parameterId": "param.slider_tolerance",
      "value": 0.01,
      "unit": "g",
      "rationale": "Slider setting must equal (26.5 + w) g to the assumed balance resolution (gap F3).",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "measurement_tolerance",
      "version": 1
    },
    {
      "parameterId": "param.balance_resolution",
      "value": 0.01,
      "unit": "g",
      "rationale": "Four beam balance readability is not stated on the approved pages (gap F3); 0.01 g assumed for display rounding and the zero band.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "measurement_tolerance",
      "version": 1
    },
    {
      "parameterId": "param.concentration_relative_tolerance",
      "value": 0.01,
      "unit": "fraction",
      "rationale": "No concentration tolerance in NIE sources (gap F3). 1% relative error accepted as a provisional teaching threshold.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "measurement_tolerance",
      "version": 1
    },
    {
      "parameterId": "param.watch_glass_mass_range",
      "value": {
        "min": 20,
        "max": 40
      },
      "unit": "g",
      "rationale": "The handbook calls the watch-glass mass w g without a value; a seeded value in this range makes each session's w different but reproducible.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "initial_state",
      "version": 1
    },
    {
      "parameterId": "param.watch_glass_residue_fraction",
      "value": 0.004,
      "unit": "fraction",
      "rationale": "Fraction of transferred solid left on the watch glass if it is not rinsed (gap F16). Deterministic, about 0.1 g of 26.5 g.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "numeric_consequence",
      "version": 1
    },
    {
      "parameterId": "param.funnel_residue_fraction",
      "value": 0.003,
      "unit": "fraction",
      "rationale": "Fraction of solid passing through the funnel that stays in it if the funnel is not rinsed (gap F16). Deterministic.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "numeric_consequence",
      "version": 1
    },
    {
      "parameterId": "param.rinse_volume",
      "value": 10,
      "unit": "cm3",
      "rationale": "Volume of distilled water added to the flask by one rinse from the wash bottle; not stated in sources.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "numeric_consequence",
      "version": 1
    },
    {
      "parameterId": "param.eye_level_volume_error",
      "value": {
        "min": 0.3,
        "max": 1.0
      },
      "unit": "cm3",
      "rationale": "Seeded parallax error magnitude when the meniscus is judged with the eye above (+) or below (−) the mark (gap F2). Not an NIE value.",
      "sourceType": "simulation_assumption",
      "reviewStatus": "teacher_review_pending",
      "effectCategory": "numeric_consequence",
      "version": 1
    },
    {
      "parameterId": "param.required_inversions",
      "value": 10,
