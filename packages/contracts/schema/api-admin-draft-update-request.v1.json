          ]
        },
        "syllabusUnit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "aims": {
          "maxItems": 100,
