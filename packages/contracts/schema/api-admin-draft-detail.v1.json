{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "importId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "needs_review",
            "content_approved",
            "archived"
          ]
        },
        "content": {
          "type": "object",
          "properties": {
            "experimentNumber": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "syllabusUnit": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "aims": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "apparatus": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "chemicals": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "procedure": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "precautions": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "calculations": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "observations": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "preLabQuestions": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "postLabQuestions": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "required": [
            "experimentNumber",
            "title",
            "syllabusUnit",
            "aims",
            "apparatus",
            "chemicals",
            "procedure",
            "precautions",
            "calculations",
            "observations",
            "preLabQuestions",
            "postLabQuestions"
          ],
          "additionalProperties": false
        },
        "sourcePages": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "maxItems": 400,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "fieldReview": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "fieldEdited": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "extractionIssues": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "field": {
                "type": "string",
                "maxLength": 64
              },
              "message": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "code",
              "field",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sourceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "documentName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "importKind": {
              "type": "string",
              "enum": [
                "guide",
                "single"
              ]
            },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "pageRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "sourceSha256",
            "documentName",
            "importKind",
            "extractorVersion",
            "pageRange"
          ],
          "additionalProperties": false
        },
        "translation": {
          "type": "object",
          "properties": {
            "si": {
              "type": "string",
              "enum": [
                "not_started",
                "draft",
                "teacher_review_pending"
              ]
            }
          },
          "required": [
            "si"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version",
        "createdAt",
        "updatedAt",
        "importId",
        "status",
        "content",
        "sourcePages",
        "fieldReview",
        "fieldEdited",
        "extractionIssues",
        "provenance",
        "translation"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "contentComplete": {
          "type": "boolean"
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "experimentNumber",
              "title",
              "syllabusUnit",
              "aims",
              "apparatus",
              "chemicals",
              "procedure",
              "precautions",
              "calculations",
              "observations",
              "preLabQuestions",
              "postLabQuestions"
            ]
          }
        },
        "provenanceOk": {
          "type": "boolean"
        },
        "provenanceIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "published",
                  "draft",
                  "document"
                ]
              },
              "experimentNumber": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "otherId": {
                "type": "string",
                "maxLength": 64
              },
              "otherTitle": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conflictingTitle": {
                "type": "boolean"
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "experimentNumber",
              "otherId",
              "otherTitle",
              "conflictingTitle",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "sinhalaReview": {
          "type": "string",
          "enum": [
            "not_started",
            "draft",
            "teacher_review_pending"
          ]
        },
        "reviewComplete": {
          "type": "boolean"
        },
        "unreviewedFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "experimentNumber",
              "title",
              "syllabusUnit",
              "aims",
              "apparatus",
              "chemicals",
              "procedure",
              "precautions",
              "calculations",
              "observations",
              "preLabQuestions",
              "postLabQuestions"
            ]
          }
        },
        "simulation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "simulation_pending"
            },
            "reason": {
              "type": "string",
              "enum": [
                "no_validated_definition",
                "unsupported_type"
              ]
            },
            "supportedKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "reason",
            "supportedKinds"
          ],
          "additionalProperties": false
        },
        "runnable": {
          "type": "boolean",
          "const": false
        },
        "canApproveContent": {
          "type": "boolean"
        },
        "blocking": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "required": [
        "contentComplete",
        "missingFields",
        "provenanceOk",
        "provenanceIssues",
        "duplicates",
        "sinhalaReview",
        "reviewComplete",
        "unreviewedFields",
        "simulation",
        "runnable",
        "canApproveContent",
        "blocking",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "draft",
    "validation"
  ],
  "additionalProperties": false
}
