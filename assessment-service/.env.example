# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="Assessment Service"
APP_ENV=development

# Supabase -> Connect -> Direct -> Session pooler -> URI (replace [YOUR-PASSWORD]).
# Example: postgresql://postgres.abcdefgh:MyPassword123@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Without a value, a local SQLite file (assessment.db) is used.
DATABASE_URL=

# Key for the /admin endpoints (send it in the X-Admin-Key header). At least 16 characters.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without a value, the admin endpoints are switched off.
ADMIN_API_KEY=
