{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "const": "development"
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxUploadBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxPages": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxUploadBytes",
        "maxPages"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "drafts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contentApproved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validationFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "drafts",
        "needsReview",
        "contentApproved",
        "validationFailures",
        "imports"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "import_guide",
          "import_single",
          "edit",
          "validate",
          "review",
          "knowledge_build",
          "users",
          "audit",
          "assist"
        ]
      }
    }
  },
  "required": [
    "mode",
    "limits",
    "counts",
    "operations"
  ],
  "additionalProperties": false
}
