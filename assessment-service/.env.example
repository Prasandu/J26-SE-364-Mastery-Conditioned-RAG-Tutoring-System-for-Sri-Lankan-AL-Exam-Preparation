# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME="Assessment Service"
APP_ENV=development

# Database. Supabase -> Connect -> Direct -> Session pooler -> URI.
# Empty = a local SQLite file (assessment.db).
DATABASE_URL=

# Staff keys, at least 16 characters each.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = that API is switched off.
ADMIN_API_KEY=
TEACHER_API_KEY=

# Real user accounts (register/login), at least 32 characters. Same way to make one
# as above. Empty = /auth is switched off. Changing this logs every signed-in user
# out, since it invalidates every token already issued.
JWT_SECRET=

# AI judge. gemini | groq | openrouter | cerebras | github | ollama | custom
AI_PROVIDER=gemini
# Key for every provider except gemini. Ollama needs none.
AI_API_KEY=
# Empty = the provider's default. List them with: python -m app.check_ai --models
AI_MODEL=
# Only for AI_PROVIDER=custom.
AI_BASE_URL=
# Below this confidence (0-1), a decision goes to a teacher instead of counting.
AI_MIN_CONFIDENCE=0.7
# Also ask the AI about points the checker decided. Disagreement -> teacher.
AI_CROSS_CHECK=true

# Google Gemini. Key from https://aistudio.google.com -> Get API key.
# Free tier: use anonymised answers only, never real student details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Reading handwriting. Needs a model that can see images.
VISION_PROVIDER=gemini
# Empty = use GEMINI_MODEL above.
VISION_MODEL=

# Backup reader, used only if the primary one above fails (busy, rate limited,
# quota used up). Empty = no fallback, an upload just fails when the primary does.
# Example: Groq's free quota as a backup for Gemini's, reusing AI_API_KEY above.
# VISION_FALLBACK_PROVIDER=groq
# VISION_FALLBACK_MODEL=qwen/qwen3.8-27b
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_MODEL=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Which web origins may call this API (the frontend). Comma separated.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Resource retrieval (RAG): grounding generated questions in trusted Chemistry
# resources. Always Gemini - Groq has no embedding endpoint. Needs GEMINI_API_KEY
# above; without it, generation behaves exactly as before resources existed.
EMBEDDING_MODEL=gemini-embedding-001
# Measured, not assumed - see docs/rag-resources.md. The model's own default is
# 3072; 768 is a real reduced embedding (Matryoshka Representation Learning), not a
# naive truncation, and costs less to store and search.
EMBEDDING_DIMENSIONS=768
# Below this cosine similarity a passage is left out, not padded in anyway.
RESOURCE_MIN_SIMILARITY=0.5
RESOURCE_PASSAGES_PER_TOPIC=2
# Where original resource PDFs are kept. Never served by any route.
RESOURCES_DIR=resources
MAX_RESOURCE_UPLOAD_MB=40

# Verifying generated questions. The deterministic validators always run, free.
# true also asks a second model to critique each question, at one extra call each.
# A critique can only refer a question to a teacher, never reject or approve it.
VERIFY_WITH_AI=false

# How many times a section may be asked for again when questions are rejected.
GENERATE_MAX_ATTEMPTS=2

# Practice papers a student may make per day (the AI quota is shared)
PRACTICE_PAPERS_PER_DAY=3
PRACTICE_QUESTIONS_AT_ONCE=15

# Whole-service ceiling on practice papers per day (protects the AI quota)
PRACTICE_PAPERS_PER_DAY_TOTAL=40
