{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "version": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "activeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "activeVersion",
        "baseVersion"
      ],
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "llmModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "llmRouting": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "order": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "provider",
                      "model"
                    ],
                    "additionalProperties": false
                  }
                },
                "circuit": {
                  "type": "string",
                  "enum": [
                    "closed",
                    "open",
                    "half_open"
                  ]
                },
                "fallbackRequestsRemainingToday": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "order",
                "circuit",
                "fallbackRequestsRemainingToday"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "embeddings": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "llm",
        "llmModel",
        "llmRouting",
        "embeddings"
      ],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "engineVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ready",
        "engineVersion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "version",
    "environment",
    "adapters",
    "verifier"
  ],
  "additionalProperties": false
}
