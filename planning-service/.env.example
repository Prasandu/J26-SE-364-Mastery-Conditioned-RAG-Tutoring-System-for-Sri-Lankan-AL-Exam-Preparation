DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
INGEST_API_KEY=
# SEC-008: one key per calling component (sent as X-Integration-Key), 16+ characters each.
INTEGRATION_KEY_COMPONENT1=
INTEGRATION_KEY_COMPONENT2=
INTEGRATION_KEY_COMPONENT4=
DEMO_MODE=false
# Frontend origins allowed to call the API, comma-separated (default http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
DEMO_STUDENT_IDS=c75c747b-a322-4bd3-9d03-6a2d3c95d916,614f0cf0-bd67-461d-9958-0bd24adbce04,06a92599-4296-4896-9a95-0272b932e517
MODEL_DIR=
# Assessment service (component 2) and its INTEGRATION_KEY_COMPONENT3.
ASSESSMENT_SERVICE_URL=http://127.0.0.1:8001
ASSESSMENT_SERVICE_API_KEY=
# Finalized-mark pull: pages per run, events per page.
ASSESSMENT_FEED_MAX_PAGES=20
ASSESSMENT_FEED_PAGE_SIZE=500
HYBRID_MODEL_ENABLED=
HYBRID_MODEL_STACKING_WEIGHT=0.35
HYBRID_MODEL_MAX_HISTORY=24

# development | test | production. Production refuses DEMO_MODE=true.
ENVIRONMENT=development
