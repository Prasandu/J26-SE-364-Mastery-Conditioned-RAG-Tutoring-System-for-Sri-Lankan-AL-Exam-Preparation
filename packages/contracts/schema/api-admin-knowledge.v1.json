{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "embedding_provider_disabled",
            "repository_unavailable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string",
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "embeddingProvider": {
      "type": "string",
      "enum": [
        "disabled",
        "fake",
        "e5_local"
      ]
    },
    "embeddingModel": {
      "type": "string",
      "maxLength": 120
    },
    "baseVersion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "knowledgeVersion": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,80}$"
            },
            "chunkCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "embeddingModel": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "knowledgeVersion",
            "chunkCount",
            "embeddingModel"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "status": {
            "type": "string",
            "enum": [
              "staged",
              "active",
              "superseded"
            ]
          },
          "knowledgeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "baseVersion": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,80}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "draftIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "chunkCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "carriedChunks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "newChunks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skippedExact": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skippedNear": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "embeddingModel": {
            "type": "string",
            "maxLength": 120
          },
          "modelRevision": {
            "type": "string",
            "maxLength": 120
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "draftId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "query": {
                  "type": "string",
                  "maxLength": 300
                },
                "hit": {
                  "type": "boolean"
                }
              },
              "required": [
                "draftId",
                "query",
                "hit"
              ],
              "additionalProperties": false
            }
          },
          "checkPassed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "createdAt",
          "updatedAt",
          "status",
          "knowledgeVersion",
          "baseVersion",
          "draftIds",
          "chunkCount",
          "carriedChunks",
          "newChunks",
          "skippedExact",
          "skippedNear",
          "embeddingModel",
          "modelRevision",
          "checks",
          "checkPassed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "available",
    "reason",
    "repository",
    "embeddingProvider",
    "embeddingModel",
    "baseVersion",
    "active",
    "builds"
  ],
  "additionalProperties": false
}
