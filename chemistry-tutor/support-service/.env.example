# Copy this file to .env and fill in real values. Never commit the real .env file.

# App
ENVIRONMENT=development

# Supabase: the one project shared by all four components; this service owns the
# "support" schema. SUPABASE_URL is also where sign-in tokens are verified (JWKS).
SUPABASE_URL=
SUPABASE_KEY=
DB_SCHEMA=support
# Use the Session Pooler URI (Connect > Direct Connection > Session pooler),
# not the direct db.<ref>.supabase.co host — that one is IPv6-only and will
# fail to connect on most home/office networks.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=

# Sinhala speech-to-text only (English STT uses Groq Whisper). Empty = no Sinhala voice input.
GEMINI_API_KEY=

# POST /tutor/ask-raw is an UNGROUNDED model call kept only for development
# comparison with /tutor/ask. false (default) = the route answers 404.
# The service refuses to start with true when ENVIRONMENT=production.
ENABLE_RAW_TUTOR=false

# Machine ingestion (POST /practice/flagged-questions) from the assessment service,
# sent as X-Integration-Key. At least 16 characters; empty = ingestion switched off.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
INTEGRATION_KEY_COMPONENT2=
