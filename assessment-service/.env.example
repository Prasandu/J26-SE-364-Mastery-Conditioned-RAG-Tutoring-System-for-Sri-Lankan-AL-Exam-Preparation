# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="Assessment Service"
APP_ENV=development

# Supabase -> Connect -> Direct -> Session pooler -> URI (replace [YOUR-PASSWORD]).
# Example: postgresql://postgres.abcdefgh:MyPassword123@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Without a value, a local SQLite file (assessment.db) is used.
DATABASE_URL=

# Key for the /admin endpoints (send it in the X-Admin-Key header). At least 16 characters.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without a value, the admin endpoints are switched off.
ADMIN_API_KEY=

# --- AI judge for written answers ---
# Which service marks written answers. Without a key, written answers stay "pending".
#   gemini | groq | openrouter | cerebras | github | ollama | custom
AI_PROVIDER=gemini
# AI decisions below this confidence (0-1) go to teacher review instead of counting.
AI_MIN_CONFIDENCE=0.7

# Google Gemini (AI_PROVIDER=gemini). Key from https://aistudio.google.com -> Get API key.
# Free tier: use test or anonymised answers only, never real student details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Every other provider. Groq key: https://console.groq.com -> API Keys.
# Ollama needs no key. "custom" needs AI_BASE_URL and AI_MODEL.
# Model names change: run `python -m app.check_ai` to list the ones your key can use.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
