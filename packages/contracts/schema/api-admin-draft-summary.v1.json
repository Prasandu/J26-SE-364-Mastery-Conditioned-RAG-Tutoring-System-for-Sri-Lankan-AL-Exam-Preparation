{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "content_approved",
        "archived"
      ]
    },
    "experimentNumber": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "syllabusUnit": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "documentName": {
      "type": "string",
      "maxLength": 120
    },
    "importId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "validation": {
      "type": "object",
      "properties": {
        "contentComplete": {
          "type": "boolean"
        },
        "blockingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canApproveContent": {
          "type": "boolean"
        },
        "simulation": {
          "type": "string",
          "const": "simulation_pending"
        }
      },
      "required": [
        "contentComplete",
        "blockingCount",
        "warningCount",
        "canApproveContent",
        "simulation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "experimentNumber",
    "title",
    "syllabusUnit",
    "documentName",
    "importId",
    "updatedAt",
    "validation"
  ],
  "additionalProperties": false
}
