# The integrated web app (all 4 components). Copy to .env. Vite exposes VITE_* to
# the browser: never put a secret here. The Supabase anon key is public by design.

# The shared Supabase project: one sign-in for all four components.
VITE_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> anon public key
VITE_SUPABASE_ANON_KEY=

# Component 2 - assessment-service
VITE_API_URL=http://127.0.0.1:8001
# Component 3 - planning-service
VITE_PLANNING_API_URL=http://127.0.0.1:8083
# Component 4 - chemistry-tutor/support-service
VITE_SUPPORT_API_URL=http://127.0.0.1:8002
# Component 1 - virtual lab web app (apps/web)
VITE_LAB_URL=http://localhost:5174
