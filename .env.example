# Copy to .env (gitignored). Never commit real values.
# The defaults run fully offline: local engine in the browser, no LLM, no embeddings.

# --- API (read by apps/api, prefix LAB_) ---
# development | test | production. Production refuses to start without real authentication.
LAB_ENVIRONMENT=development
# development (fixed local learner; development only) | supabase_jwt (placeholder, fails closed)
LAB_PRINCIPAL_PROVIDER=development
# memory (data is lost when the process stops) | postgres (not implemented in M1)
LAB_REPOSITORY=memory
# Server-side only. Required when LAB_REPOSITORY=postgres, e.g. postgresql://user:pass@localhost:5432/lab
# LAB_DATABASE_URL=
# Explicit browser origins allowed to call the API (no wildcard).
LAB_CORS_ORIGINS=["http://localhost:5173"]
# Absolute path to Node for the verifier CLI; defaults to the `node` found on PATH at startup.
# LAB_VERIFIER_NODE=
LAB_VERIFIER_TIMEOUT_SECONDS=10
# Development-only admin drafts (D31): disabled (default; /admin/dev/* returns 404) | development
# (refused unless LAB_ENVIRONMENT=development; loopback requests only; never in production).
LAB_ADMIN_MODE=disabled
# Private, gitignored draft storage (must not be inside content/).
# LAB_ADMIN_DATA_DIR=data/admin
# Upload limits and extraction timeout.
# LAB_ADMIN_MAX_UPLOAD_BYTES=26214400
# LAB_ADMIN_MAX_PAGES=400
# LAB_ADMIN_EXTRACT_TIMEOUT_SECONDS=60
# Where admin records live: file (private JSON under LAB_ADMIN_DATA_DIR; no setup) | postgres
# (needs LAB_DATABASE_URL and the supabase/migrations applied). Uploaded PDFs always stay on disk.
LAB_ADMIN_REPOSITORY=file
# Optional AI help when extracting practicals: disabled | ollama (LOCAL model only; needs
# LAB_OLLAMA_MODEL). Suggestions must quote the PDF page and are never applied automatically.
LAB_ADMIN_EXTRACTION_ASSIST=disabled
# Grounded assistant generation:
#   disabled (default) | fake (development/test only; never production)
#   | openai | groq | ollama (one explicitly selected provider, no fallback; ollama = local model)
#   | failover (ordered providers, default groq then openai; technical failures only, D30)
# Grounding or safety refusals and validation failures NEVER trigger failover.
LAB_LLM_PROVIDER=disabled
# OpenAI model (openai, and the paid fallback in failover). See DECISIONS D26.
LAB_LLM_MODEL=gpt-6.1-sol
# OpenAI reasoning effort: none | minimal | low | medium | high
LAB_LLM_REASONING_EFFORT=low
LAB_LLM_MAX_OUTPUT_TOKENS=512
# Single-provider call timeout (openai or groq selected directly).
LAB_LLM_TIMEOUT_SECONDS=20
# Groq model (groq, and the primary in failover); strict JSON-schema structured output.
LAB_GROQ_MODEL=qwen/qwen3.8-27b
# Failover routing (used only when LAB_LLM_PROVIDER=failover):
LAB_LLM_FAILOVER_ORDER=["groq","openai"]
LAB_LLM_PRIMARY_TIMEOUT_SECONDS=12
LAB_LLM_FALLBACK_TIMEOUT_SECONDS=18
LAB_LLM_TOTAL_DEADLINE_SECONDS=30
# Circuit cooldown after a primary 429/5xx when no Retry-After header is given (process-local).
LAB_LLM_CIRCUIT_COOLDOWN_SECONDS=60
# Paid OpenAI fallback calls per UTC day (process-local). Also set a low budget and spending
# alerts on the OpenAI Platform project; this counter is not a billing control.
LAB_OPENAI_FALLBACK_DAILY_REQUEST_LIMIT=50
# Server-side secrets. Put real values ONLY in the untracked .env (or the server environment);
# never in this file, commits, logs, chats or screenshots. Rotate any key that was exposed.
GROQ_API_KEY=
OPENAI_API_KEY=
# Local LLM through Ollama (this computer only; the URL must be loopback). Used when
# LAB_LLM_PROVIDER=ollama and/or LAB_ADMIN_EXTRACTION_ASSIST=ollama. Pick a model you pulled with
# `ollama pull <tag>`; no model is hard-coded.
# LAB_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LAB_OLLAMA_MODEL=
# LAB_OLLAMA_TIMEOUT_SECONDS=60
# Query embeddings: disabled | fake (tests) | e5_local (needs the `rag` dependency group and the
# private knowledge data built by scripts/ingest/build_knowledge.py).
LAB_EMBEDDING_PROVIDER=disabled
LAB_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pinned Hugging Face revision; defaults to the revision recorded in content/knowledge/manifest.v1.json.
# LAB_EMBEDDING_REVISION=
# Private, gitignored chunk text and embeddings (server-side only).
# LAB_KNOWLEDGE_DATA_DIR=data/knowledge
# Knowledge-base store shared by the assistant and the admin knowledge feed:
# memory (private files; default) | postgres (pgvector tables; needs LAB_DATABASE_URL).
LAB_KNOWLEDGE_REPOSITORY=memory
# Run the local model without network access once it is cached.
# HF_HUB_OFFLINE=1

# --- Web (Vite exposes VITE_* vars to the browser: never put secrets here) ---
# local (offline engine in the browser) | api (FastAPI + server-side verifier)
VITE_ENGINE_ADAPTER=local
VITE_API_BASE_URL=http://localhost:8000
