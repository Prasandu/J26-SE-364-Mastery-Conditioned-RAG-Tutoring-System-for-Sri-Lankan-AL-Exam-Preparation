# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME="Assessment Service"
APP_ENV=development

# Database. Supabase -> Connect -> Direct -> Session pooler -> URI.
# Empty = a local SQLite file (assessment.db).
DATABASE_URL=

# Staff keys, at least 16 characters each.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = that API is switched off.
ADMIN_API_KEY=
TEACHER_API_KEY=

# AI judge. gemini | groq | openrouter | cerebras | github | ollama | custom
AI_PROVIDER=gemini
# Key for every provider except gemini. Ollama needs none.
AI_API_KEY=
# Empty = the provider's default. List them with: python -m app.check_ai --models
AI_MODEL=
# Only for AI_PROVIDER=custom.
AI_BASE_URL=
# Below this confidence (0-1), a decision goes to a teacher instead of counting.
AI_MIN_CONFIDENCE=0.7
# Also ask the AI about points the checker decided. Disagreement -> teacher.
AI_CROSS_CHECK=true

# Google Gemini. Key from https://aistudio.google.com -> Get API key.
# Free tier: use anonymised answers only, never real student details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Reading handwriting. Needs a model that can see images (Groq's cannot).
VISION_PROVIDER=gemini
# Empty = use GEMINI_MODEL above.
VISION_MODEL=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
