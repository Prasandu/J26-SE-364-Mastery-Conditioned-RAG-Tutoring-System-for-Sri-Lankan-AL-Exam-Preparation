# Copy this file to .env and fill in real values. Never commit the real .env file.

# App
ENVIRONMENT=development

# Supabase (shared project, this service uses the "support" schema)
SUPABASE_URL=
SUPABASE_KEY=
DB_SCHEMA=support
# Use the Session Pooler URI (Connect > Direct Connection > Session pooler),
# not the direct db.<ref>.supabase.co host — that one is IPv6-only and will
# fail to connect on most home/office networks.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=
